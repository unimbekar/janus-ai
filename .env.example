# Janus local development configuration.
#
# Copy to .env and adjust. Never commit .env — it is ignored by git.
# Secrets in deployed environments come from AWS Secrets Manager, never files.

# ---------------------------------------------------------------- environment
JANUS_ENVIRONMENT=local
JANUS_LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
# The service connects as janus_app, a role subject to row-level security.
JANUS_DATABASE_URL=postgresql+asyncpg://janus_app:janus_app@localhost:5432/janus
# Migrations connect as the owner. DDL only; never used by the running service.
JANUS_MIGRATION_DATABASE_URL=postgresql+asyncpg://janus:janus@localhost:5432/janus
# Local-only convenience: the password the migration gives to the app role.
JANUS_APP_DB_PASSWORD=janus_app

# ------------------------------------------------------------- host ports
# Published ports for the compose stack. Override any that are already in use
# on your machine; nothing inside the stack depends on these values.
# IMPORTANT: JANUS_API_PORT and JANUS_GATEWAY_PORT must be different numbers.
JANUS_POSTGRES_PORT=5432
JANUS_API_PORT=8080
JANUS_GATEWAY_PORT=8081
JANUS_WEB_PORT=3000

# Which interface the published ports listen on. The default reaches every
# network the host is attached to, which is fine for a laptop. On a shared or
# always-on machine, pin it — e.g. 127.0.0.1 for local only, or a private
# network address (Tailscale, VPN) to reach it remotely without exposing the
# stack to the local network. There is no TLS here, so this matters.
# JANUS_BIND_ADDRESS=127.0.0.1

# -------------------------------------------------------------------- gateway
JANUS_GATEWAY_URL=http://localhost:8081
# Shared secret between the control plane and the gateway. Any non-empty value
# works locally; deployed environments read it from Secrets Manager.
JANUS_GATEWAY_SERVICE_TOKEN=local-dev-token
JANUS_REGISTRY_DIR=registry

# ---------------------------------------------------------------------- local
# Cookies are not sent over plain HTTP when Secure is set, so local development
# turns it off. Never do this anywhere else.
JANUS_SESSION_COOKIE_SECURE=false
# Only needed if the browser calls the control plane directly. By default the web
# app proxies /api/* to it, so requests are same-origin and CORS never applies.
JANUS_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Where the *web server* reaches the control plane, server side. Never sent to
# the browser. Inside compose this is http://api:8080.
JANUS_API_URL=http://localhost:8080

# --------------------------------------------------------------- local models
# Host-side Ollama (make run-gateway / tests). Compose uses a different URL —
# see JANUS_OLLAMA_COMPOSE_URL — because 127.0.0.1 inside a container is not the host.
JANUS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Gateway container → host Ollama (install.sh start / make stack-up)
JANUS_OLLAMA_COMPOSE_URL=http://host.docker.internal:11434/v1

# Which Ollama tags to ensure on start (merged with config/local-models.yaml).
# Example: JANUS_LOCAL_OLLAMA_MODELS=nemotron35lightning:latest,llama3.1:8b
# JANUS_LOCAL_OLLAMA_MODELS=
# Ollama must listen beyond loopback so Compose can reach it (install.sh sets this).
# JANUS_OLLAMA_LISTEN=0.0.0.0:11434

# ----------------------------------------------------------------- telemetry
# Leave unset to disable tracing locally.
# JANUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------------- tests
# API tests need Postgres; they skip without this.
JANUS_TEST_DATABASE_URL=postgresql+asyncpg://janus:janus@localhost:5432/janus_test
# Opt in to conformance tests against a live Ollama.
# JANUS_TEST_OLLAMA=1
