# Janus Intelligence — design phase artifacts only.
# Implementation begins after Phase 0 review; these entries are in place for later phases.

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/secrets/*.yaml
!**/secrets/*.example.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
.terraform.lock.hcl

# Kubernetes rendered output
deploy/kubernetes/**/rendered/

# Local data / models
*.db
*.sqlite3
/data/
/models/
*.gguf
*.safetensors

# Logs / OS / editor
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
